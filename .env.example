# HTTP server address (env overrides config/app.yaml)
VVSAPP_SERVER_ADDRESS=:8080

# SQLite database location
VVSAPP_DB_PATH=./local.db

# Logging level (info|debug)
VVSAPP_LOG_LEVEL=info

# Auth + seeding
VVSAPP_JWT_SECRET=local-dev-secret-please-change
VVSAPP_ADMIN_EMAIL=admin@example.com
VVSAPP_ADMIN_PASSWORD=changeme123
VVSAPP_TOKEN_TTL_MINUTES=15

# HP Acuity verified webhook relay -> Google Sheets _ExternalBookingEvents queue
HPAPP_ACUITY_WEBHOOK_SECRET=
HPAPP_ACUITY_QUEUE_SPREADSHEET_ID=1gWXpPXkuoNdK9I5KyPqDYD3Re0Mbn3ouDxpCjxJ_5MA
HPAPP_EXTERNAL_BOOKING_QUEUE_RANGE='_ExternalBookingEvents'!A:P
VVSAPP_GOOGLE_SERVICE_ACCOUNT_JSON=
VVSAPP_GOOGLE_SERVICE_ACCOUNT_FILE=
